{
  "name": "adeptos-content-mcp",
  "version": "1.0.0",
  "description": "Adeptos-owned MCP: Canva photos/carousels/posts to IG, FB, TikTok, YouTube, LinkedIn, and X. Streamable HTTP + stdio.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "adeptos-content-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsx src/index.ts --http",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "meta",
    "instagram",
    "facebook",
    "content-publishing",
    "adeptos"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
