# Adeptos Content MCP — copy to .env (never commit real secrets)
# Grok Bot live proof: Meta IG/FB Content Publishing.
# Leonardo owns tokens / pages / brand map (Rec0C3QKVTL0Y).

# Token: System User or long-lived User with Page access.
# Scopes: instagram_basic, instagram_content_publish, pages_show_list,
#         pages_read_engagement, pages_manage_posts
#         (+ business_management if multi-BM)
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# Brand map: hamill | zono | adeptos → IG Business user id + linked FB Page id
BRAND_HAMILL_IG_USER_ID=
BRAND_HAMILL_PAGE_ID=
BRAND_HAMILL_NAME=Hamill

BRAND_ZONO_IG_USER_ID=
BRAND_ZONO_PAGE_ID=
BRAND_ZONO_NAME=Zono

BRAND_ADEPTOS_IG_USER_ID=
BRAND_ADEPTOS_PAGE_ID=
BRAND_ADEPTOS_NAME=Adeptos

# Optional HTTP (stdio does not need these)
# PORT=3848
# HOST=127.0.0.1
