# Adeptos Content MCP — copy to .env (never commit real secrets)
# Grok Bot live proof: Meta IG/FB Content Publishing.
# Leonardo owns tokens / pages / brand map (Rec0C3QKVTL0Y).
#
# Two Meta Business Manager portfolios (not three):
#   1. Ryan Hamill BM — Hamill + Adeptos AI Instagram/Page assets
#      brands hamill + adeptos share one Meta token
#   2. ZONO BM — Zono assets → brand zono has its own Meta token
# Never reuse another brand/portfolio token. Writes still need confirm:true.

# Token scopes: instagram_basic, instagram_content_publish, pages_show_list,
#               pages_read_engagement, pages_manage_posts
#               (+ business_management if the System User spans both BMs)
META_GRAPH_VERSION=v21.0

# --- Ryan Hamill portfolio (hamill + adeptos) ---
# Prefer per-brand override if set: BRAND_HAMILL_META_ACCESS_TOKEN / BRAND_ADEPTOS_META_ACCESS_TOKEN
# Else either shared key works for both hamill and adeptos:
META_ACCESS_TOKEN=
META_HAMILL_ACCESS_TOKEN=
# BRAND_HAMILL_META_ACCESS_TOKEN=
# BRAND_ADEPTOS_META_ACCESS_TOKEN=

# --- ZONO portfolio (zono only — do not put the Hamill token here) ---
META_ZONO_ACCESS_TOKEN=
# BRAND_ZONO_META_ACCESS_TOKEN=

# Brand map: hamill | zono | adeptos → IG Business user id + linked FB Page id
BRAND_HAMILL_IG_USER_ID=
BRAND_HAMILL_PAGE_ID=
BRAND_HAMILL_NAME=Hamill

BRAND_ZONO_IG_USER_ID=
BRAND_ZONO_PAGE_ID=
BRAND_ZONO_NAME=Zono

BRAND_ADEPTOS_IG_USER_ID=
BRAND_ADEPTOS_PAGE_ID=
BRAND_ADEPTOS_NAME=Adeptos

# Optional HTTP (stdio does not need these)
# PORT=3848
# HOST=127.0.0.1
